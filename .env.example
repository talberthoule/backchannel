# Optional fallback -- you can instead add keys in Admin -> Connections
# GEMINI_API_KEY=your-gemini-api-key-here

# PyTorch wheel channel for the optional Sortformer diarizer.
# Default "auto": CUDA wheels only when an NVIDIA GPU is detected
# (nvidia-smi on PATH), otherwise the much smaller CPU wheels with
# identical CPU performance. Docker builds never see a GPU, so images
# get CPU wheels unless you set this explicitly. Accepts a shorthand
# channel ("cpu", "cu130", "rocm6.4") or a full index URL.
# PYTORCH_INDEX_URL=auto

# Database settings are optional: docker-compose.yml provides defaults for
# POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB and derives the backend
# DATABASE_URL from them. Uncomment only to override, and keep the values in
# sync with each other.
# POSTGRES_USER=backchannel
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=backchannel
# DATABASE_URL=postgresql+asyncpg://backchannel:changeme@db:5432/backchannel
