{
  "name": "backchannel-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build && node assemble.mjs",
    "test:admin": "node --test admin.test.js",
    "test:download": "node --test download.test.js",
    "test:release-access": "node --test release-access.test.js",
    "test:migration": "node --test migration.test.js",
    "test:worker": "node --test worker.test.js",
    "test:site": "node --test site.test.js",
    "preview": "astro preview",
    "preview:admin": "node admin-preview.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "@noble/hashes": "2.2.0",
    "astro": "^7.0.7",
    "jose": "^6.2.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "wrangler": "^4.115.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2"
  }
}
